{
  "name": "paios-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "PAIOS Desktop - Personal AI Operating System",
  "author": "PAIOS Team",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "server:dev": "tsx watch server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:atdd": "vitest run tests/atdd/",
    "test:unit": "vitest run tests/unit/",
    "db:reset": "node -e \"['./data/paios5.sqlite','./data/paios5.sqlite-wal','./data/paios5.sqlite-shm'].forEach(f=>{try{require('fs').unlinkSync(f)}catch(e){}})\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false vite build && npx electron-packager . \"PAIOS Desktop\" --platform=win32 --arch=x64 --out=dist-electron --overwrite",
    "build:exe": "vite build && npx electron-packager . \"PAIOS Desktop\" --platform=win32 --arch=x64 --out=dist-electron --overwrite",
    "build:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:win-unpacked": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false vite build && npx electron-builder --win dir",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:3001 electron .",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.paios.desktop",
    "productName": "PAIOS Desktop",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@google/genai": "*",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
