pipeline {
    agent any

    environment {
        REPO_OWNER   = 'adsecurto-boop'
        REPO_NAME    = 'PAIOS-4.5'
        
        // Ensure standard Node and build tool paths are prioritized
        PATH         = "${env.PATH}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    triggers {
        githubPush()
        pollSCM('H/5 * * * *') // Fallback polling every 5 minutes if Webhook cannot reach Jenkins
    }

    stages {
        stage('Notify GitHub - Pending') {
            steps {
                script {
                    updateGitHubCommitStatus('PENDING', 'Desktop Windows build in progress...')
                }
            }
        }

        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Install Node Dependencies') {
            steps {
                echo "=== Installing Node Dependencies for Desktop App ==="
                bat 'IF EXIST package-lock.json ( npm ci || npm install ) ELSE ( npm install )'
            }
        }

        stage('Lint & Type Check') {
            steps {
                echo "=== Validating TypeScript & Code Quality ==="
                bat 'npm run lint'
            }
        }

        stage('Build Web Distribution') {
            steps {
                echo "=== Compiling Production Web Assets ==="
                bat 'npm run build'
            }
        }

        stage('Build & Package Electron Desktop (.exe)') {
            steps {
                echo "=== Packaging PAIOS Desktop for Windows (x64) ==="
                powershell '''
                Write-Output "[INFO] Starting Electron Desktop Windows packaging..."
                
                # Ensure output directory is clean
                if (Test-Path "dist-electron") {
                    Remove-Item -Recurse -Force "dist-electron" -ErrorAction SilentlyContinue
                }
                New-Item -ItemType Directory -Path "dist-electron" -Force | Out-Null

                # Build executable using electron-packager
                npm run build:exe
                
                # Verify and package into ZIP archive for easy distribution
                $packDir = Get-ChildItem -Path "dist-electron" -Directory | Where-Object { $_.Name -like "*PAIOS Desktop*" } | Select-Object -First 1
                if ($packDir) {
                    Write-Output "[INFO] Packaging built desktop binaries into PAIOS-Desktop-Windows-x64.zip..."
                    $zipPath = Join-Path $pwd "dist-electron/PAIOS-Desktop-Windows-x64.zip"
                    if (Test-Path $zipPath) { Remove-Item -Force $zipPath }
                    Compress-Archive -Path "$($packDir.FullName)/*" -DestinationPath $zipPath -Force
                    Write-Output "[SUCCESS] Generated desktop release archive at: $zipPath"
                } else {
                    Write-Output "[WARN] Packaged folder not found in dist-electron. Checking root outputs..."
                }

                # Write build info metadata
                $buildInfo = @"
PAIOS Desktop Windows Build
Commit: $($env:GIT_COMMIT)
Branch: $($env:GIT_BRANCH)
Build Number: $($env:BUILD_NUMBER)
Date: $(Get-Date -Format "yyyy-MM-dd HH:mm:ss UTC")
"@
                Set-Content -Path "dist-electron/BUILD_INFO.txt" -Value $buildInfo
                Write-Output "[INFO] BUILD_INFO.txt created."
                '''
            }
        }

        stage('Archive Desktop Artifacts') {
            steps {
                echo "=== Archiving Windows Desktop Binaries & Archives ==="
                archiveArtifacts artifacts: 'dist-electron/**/*.exe, dist-electron/**/*.zip, dist-electron/BUILD_INFO.txt, dist-electron/**/*', allowEmptyArchive: true
            }
        }
    }

    post {
        success {
            script {
                updateGitHubCommitStatus('SUCCESS', 'Desktop Windows build completed successfully!')
            }
            echo 'PAIOS Desktop Windows Build & Packaging Completed Successfully.'
        }
        failure {
            script {
                updateGitHubCommitStatus('FAILURE', 'Desktop Windows build failed.')
            }
            echo 'PAIOS Desktop Windows Build Failed. Check Jenkins console log for details.'
        }
    }
}

void updateGitHubCommitStatus(String state, String description) {
    def context = 'Jenkins/PAIOS-Desktop'
    
    // Resolve dynamic Repo Owner and Repo Name if not already overridden
    def repoOwner = env.REPO_OWNER ?: 'adsecurto-boop'
    def repoName = env.REPO_NAME ?: 'PAIOS-4.5'
    
    try {
        def remoteUrl = bat(script: 'git config --get remote.origin.url', returnStdout: true).trim()
        // Matches e.g., https://github.com/adsecurto-boop/PAIOS-4.3.git or git@github.com:adsecurto-boop/PAIOS-4.3.git
        def matcher = remoteUrl =~ /(?:github\.com[:\/])([^\/]+)\/([^\/\.]+?)(?:\.git)?\s*$/
        if (matcher) {
            repoOwner = matcher[0][1].trim()
            repoName  = matcher[0][2].trim()
            echo "Dynamically resolved repository from origin: ${repoOwner}/${repoName}"
        }
    } catch (Exception e) {
        echo "Could not dynamically resolve repository: ${e.message}. Using default: ${repoOwner}/${repoName}"
    }

    def commitSha = env.GIT_COMMIT
    if (!commitSha) {
        try {
            commitSha = bat(script: 'git rev-parse HEAD', returnStdout: true).trim()
        } catch (Exception e) {
            echo "Could not parse GIT_COMMIT: ${e.message}"
            return
        }
    }
    
    try {
        withCredentials([string(credentialsId: 'github-pat-token', variable: 'GITHUB_TOKEN')]) {
            if (env.GITHUB_TOKEN && commitSha) {
                def targetUrl = "${env.BUILD_URL}console"
                def payload = """{\"state\": \"${state.toLowerCase()}\", \"target_url\": \"${targetUrl}\", \"description\": \"${description}\", \"context\": \"${context}\"}"""
                
                try {
                    powershell """
                    \$headers = @{
                        "Authorization" = "token \$env:GITHUB_TOKEN"
                        "Accept" = "application/vnd.github.v3+json"
                        "Content-Type" = "application/json"
                    }
                    \$body = '${payload}'
                    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
                    Invoke-RestMethod -Uri "https://api.github.com/repos/${repoOwner}/${repoName}/statuses/${commitSha}" -Method Post -Headers \$headers -Body \$body | Out-Null
                    Write-Output "[INFO] Successfully updated GitHub commit status for ${commitSha} to ${state}"
                    """
                } catch (Exception e) {
                    echo "Warning: Failed to send status update to GitHub via PowerShell: ${e.message}"
                }
            } else {
                echo "Warning: GITHUB_TOKEN or commitSha not available. Skipping GitHub status notification."
            }
        }
    } catch (Exception e) {
        echo "Warning: 'github-pat-token' credentials could not be loaded or are missing in Jenkins. Skipping status notification. Error: ${e.message}"
    }
}
